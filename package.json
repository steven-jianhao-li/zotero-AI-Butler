{
  "name": "zotero-ai-butler",
  "type": "module",
  "version": "5.1.0",
  "description": "Your personal AI butler, automatically and meticulously reads papers and summarizes notes.",
  "config": {
    "addonName": "zotero-ai-butler",
    "addonID": "zotero-ai-butler@github.com",
    "addonRef": "aiButler",
    "addonInstance": "AIButler",
    "prefsPrefix": "extensions.zotero.aiButler"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steven-jianhao-li/zotero-AI-Butler.git"
  },
  "author": "Steven Jianhao Li",
  "bugs": {
    "url": "https://github.com/steven-jianhao-li/zotero-AI-Butler/issues"
  },
  "homepage": "https://github.com/steven-jianhao-li/zotero-AI-Butler#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "prebuild": "node ./scripts/check-i18n.mjs",
    "build": "zotero-plugin build && tsc --noEmit",
    "postbuild": "node ./scripts/check-i18n-build.mjs",
    "lint:check": "prettier --check . && node --require ./scripts/eslint-typescript-compat.cjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "prettier --write . && node --require ./scripts/eslint-typescript-compat.cjs ./node_modules/eslint/bin/eslint.js . --fix",
    "release": "zotero-plugin release",
    "pretest": "node ./scripts/check-i18n.mjs && node ./scripts/gen-env-setup.mjs",
    "test": "zotero-plugin test --exit-on-finish",
    "test:agent": "node ./scripts/test-agent.mjs",
    "test:task-queue": "node ./scripts/test-task-queue.mjs",
    "test:image-summary": "node --test test/imageSummaryQueue.test.mjs",
    "test:headers": "node ./scripts/test-request-headers.mjs",
    "test:llm-completion": "node ./scripts/test-llm-completion.mjs",
    "test:llm-lifecycle": "node --test test/llmRequestLifecycle.test.mjs",
    "test:agent:live": "node ./scripts/test-agent-live.mjs",
    "test:mineru": "node ./scripts/test-mineru.mjs",
    "test:note-export": "node --test test/noteExportNaming.test.mjs",
    "pretest:watch": "node ./scripts/gen-env-setup.mjs",
    "test:watch": "zotero-plugin test",
    "scaffold:provider": "node ./scripts/create-provider.mjs",
    "update-deps": "npm update --save",
    "i18n:check": "node ./scripts/check-i18n.mjs",
    "i18n:check:build": "node ./scripts/check-i18n-build.mjs",
    "test:i18n": "node ./scripts/check-i18n.mjs",
    "test:pdf": "node --test test/pdfExtractionRecovery.test.mjs",
    "test:epub": "node --test test/epubExtraction.test.mjs",
    "test:sidebar": "node --test test/sidebarViewport.test.mjs test/quickChatThreads.test.mjs test/uiRefresh.test.mjs",
    "test:onboarding": "node --test test/onboardingNavigation.test.mjs",
    "test:compat": "node --test test/compatibility.test.mjs",
    "test:compat:host": "node scripts/test-zotero-compat.mjs"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "core-js": "^3.50.0",
    "d3": "^7.9.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mathjax": "^4.1.3",
    "resize-observer-polyfill": "^1.5.1",
    "simple-mind-map": "^0.14.0-fix.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-unicode-property-regex": "^7.29.7",
    "@babel/plugin-transform-unicode-sets-regex": "^7.29.7",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "adm-zip": "^0.6.1",
    "chai": "^6.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
